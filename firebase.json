{
  "hosting": [
    {
      "public": "dist/pwa",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map"],
      "predeploy": ["npm run check:spark:remote", "npm run build:pwa", "npm run check:release"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        },
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/{index.html,sw.js,manifest.json,build-info.json,build-evidence.json}",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "/workbox-*.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        }
      ],
      "target": "app"
    },
    {
      "target": "docs",
      "public": "docs/.vitepress/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.map"],
      "predeploy": ["npm run check:spark:remote", "npm run docs:build"],
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/specification-v1",
          "destination": "/reports/project/specification-v1",
          "type": 301
        },
