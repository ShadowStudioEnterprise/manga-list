{
  "name": "manga-list",
  "version": "0.0.1",
  "description": "Biblioteca privada y sincronizada para seguir mangas, manhwas y manhuas.",
  "productName": "MangaList",
  "author": "shadowstudio <35380219+ShadowStudioEnterprise@users.noreply.github.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules --test tests/*.test.js",
    "test:rules": "node --experimental-vm-modules --test tests/firestore/*.test.js",
    "test:e2e": "node tests/e2e/run.js",
    "test:pwa": "node --test tests/pwa/*.test.js",
    "lint": "prettier --write \"**/*.{js,mjs,vue,css,scss,html,md,json,yml,yaml}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\" \"./tests/**/*.js\" \"./scripts/**/*.mjs\"",
    "lint:check": "prettier --check \"**/*.{js,mjs,vue,css,scss,html,md,json,yml,yaml}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\" \"./tests/**/*.js\" \"./scripts/**/*.mjs\"",
    "dev": "quasar dev",
    "build": "quasar build && node scripts/build-evidence.mjs create spa",
    "build:pwa": "quasar build -m pwa && node scripts/build-evidence.mjs create pwa",
    "check:release": "node scripts/build-evidence.mjs verify pwa --project mangalist-61bb8",
    "deploy:hosting": "npm run check:spark:remote && firebase deploy --only hosting:app --project mangalist-61bb8",
    "postinstall": "quasar prepare --silent",
    "check:spark": "node scripts/check-spark.mjs",
    "check:spark:remote": "node scripts/check-spark.mjs --remote",
    "audit:dependencies": "npm audit --audit-level=low && npm audit --prefix src-pwa --audit-level=low",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "deploy:docs": "npm run check:spark:remote && firebase deploy --only hosting:docs --project mangalist-61bb8"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "firebase": "^12.18.0",
    "pinia": "^4.0.2",
    "quasar": "^2.32.2",
    "vue": "^3.5.22",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@intlify/unplugin-vue-i18n": "^11.2.6",
    "@playwright/test": "^1.63.0",
    "@quasar/app-vite": "^3.8.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "vite": "8.2.4",
    "vite-plugin-checker": "^0.14.5",
    "vitepress": "^1.6.4",
    "vue-eslint-parser": "^10.4.0"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": "^22.22 || ^24 || ^26"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.13.6"
    },
    "vitepress": {
      "vite": "6.4.4"
    }
  },
  "license": "Apache-2.0"
}
